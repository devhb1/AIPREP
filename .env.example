OPENAI_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# Prefer Transaction pooler (port 6543) on Vercel. Session mode (5432) hits EMAXCONNSESSION.
# App auto-rewrites pooler :5432 → :6543 when possible.
TRANSACTION_POOLER_URL=
SESSION_POOLER_URL=

# Optional newer publishable key (not required if ANON_KEY is set)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Upstash Redis (REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Model routing (optional overrides)
FAST_MODEL=gpt-4.1-mini
REASONING_MODEL=gpt-4.1
EMBEDDING_MODEL=text-embedding-3-small
VOICE_MODEL=gpt-realtime-mini
STT_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=tts-1
